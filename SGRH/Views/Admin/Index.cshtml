@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Administração do Sistema";
    Layout = "_Layout";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Administração do Sistema</h1>
        <p class="page-subtitle">Gestão de utilizadores, perfis, permissões e auditoria</p>
    </div>
    <a class="btn btn-primary" href="@Url.Action("Utilizadores", "Admin")"><i class="fi fi-sr-user-gear"></i> Gerir Utilizadores</a>
</div>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}
@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger">@TempData["Erro"]</div>
}

<!-- KPIs -->
<div class="stats-grid" style="margin-bottom:1.5rem;">
    <div class="stat-card"><div class="stat-info"><h3>Total Utilizadores</h3><div class="stat-value">@Model.TotalUtilizadores</div></div><div class="stat-icon blue"><i class="fi fi-sr-users"></i></div></div>
    <div class="stat-card"><div class="stat-info"><h3>Activos</h3><div class="stat-value" style="color:var(--success);">@Model.UtilizadoresActivos</div></div><div class="stat-icon green"><i class="fi fi-sr-check-circle"></i></div></div>
    <div class="stat-card"><div class="stat-info"><h3>Bloqueados</h3><div class="stat-value" style="color:var(--danger);">@Model.UtilizadoresBloqueados</div></div><div class="stat-icon red"><i class="fi fi-sr-user-xmark"></i></div></div>
    <div class="stat-card"><div class="stat-info"><h3>Perfis</h3><div class="stat-value">@Model.TotalPerfis</div></div><div class="stat-icon amber"><i class="fi fi-sr-user-shield"></i></div></div>
    <div class="stat-card"><div class="stat-info"><h3>Acessos Hoje</h3><div class="stat-value">@Model.AcessosHoje</div></div><div class="stat-icon blue"><i class="fi fi-sr-lock-open-alt"></i></div></div>
    <div class="stat-card"><div class="stat-info"><h3>Operações Hoje</h3><div class="stat-value">@Model.OperacoesHoje</div></div><div class="stat-icon amber"><i class="fi fi-sr-bolt"></i></div></div>
</div>

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.25rem;">
    <!-- Atalhos -->
    <div class="card">
        <div class="card-header"><span class="card-title"><i class="fi fi-sr-apps" style="color:var(--info);margin-right:0.5rem;"></i> Gestão</span></div>
        <div class="card-body" style="display:flex;flex-direction:column;gap:0.75rem;">
            <a class="btn btn-outline" href="@Url.Action("Utilizadores", "Admin")"><i class="fi fi-sr-users"></i> Gestão de Utilizadores <span class="chip" style="margin-left:auto;">RF02</span></a>
            <a class="btn btn-outline" href="@Url.Action("Perfis", "Admin")"><i class="fi fi-sr-user-shield"></i> Gestão de Perfis <span class="chip" style="margin-left:auto;">RF03</span></a>
            <a class="btn btn-outline" href="@Url.Action("Auditoria", "Admin")"><i class="fi fi-sr-shield-check"></i> Auditoria e Logs <span class="chip" style="margin-left:auto;">RT08</span></a>
        </div>
    </div>

    <!-- Últimos acessos -->
    <div class="card">
        <div class="card-header"><span class="card-title"><i class="fi fi-sr-clock" style="color:var(--info);margin-right:0.5rem;"></i> Últimos Acessos</span></div>
        <div class="card-body" style="padding:0;">
            @if (!Model.UltimosAcessos.Any())
            {
                <p style="padding:1rem;color:var(--text-muted);">Sem registos de acesso.</p>
            }
            else
            {
                <div class="table-container">
                    <table>
                        <thead><tr><th>Utilizador</th><th>Data/Hora</th><th>IP</th></tr></thead>
                        <tbody>
                            @foreach (var log in Model.UltimosAcessos)
                            {
                                <tr>
                                    <td>@(log.UtilizadorSistema?.Username ?? "—")</td>
                                    <td>@log.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@(log.IpAddress ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
