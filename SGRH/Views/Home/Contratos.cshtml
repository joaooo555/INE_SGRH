@model List<SGRH.Models.Contrato>
@{
    ViewData["Title"] = "Contratos";
    ViewBag.ActivePage = "Contratos";

    var hoje = DateOnly.FromDateTime(DateTime.Now);
    var em30Dias = hoje.AddDays(30);
    int vigentes = ViewBag.Vigentes;
    int expirados = ViewBag.Expirados;
    int aExpirar = ViewBag.AExpirar;
    int renovacoesPendentes = ViewBag.RenovacoesPendentes;
    var alertas = Model.Where(c => c.Estado == "Vigente" && c.DataFim.HasValue && c.DataFim.Value >= hoje && c.DataFim.Value <= em30Dias).ToList();
}

<div class="page-header">
    <div>
        <h1 class="page-title">Gestão de Contratos</h1>
        <p class="page-subtitle">Registo e acompanhamento de contratos de trabalho</p>
    </div>
    <div style="display:flex;gap:0.5rem;">
        <a href="@Url.Action("NovoContrato")" class="btn btn-primary">
            <i class="fi fi-sr-plus"></i> Novo Contrato
        </a>
    </div>
</div>

<!-- KPIs -->
<div class="stats-grid" style="margin-bottom:1.5rem;">
    <div class="stat-card">
        <div class="stat-info">
            <h3>Contratos Vigentes</h3>
            <div class="stat-value">@vigentes</div>
            <span class="stat-change positive">Ativos no sistema</span>
        </div>
        <div class="stat-icon blue"><i class="fi fi-sr-file-invoice"></i></div>
    </div>
    <div class="stat-card">
        <div class="stat-info">
            <h3>A Expirar &lt;30 dias</h3>
            <div class="stat-value">@aExpirar</div>
            <span class="stat-change negative">Requer atenção</span>
        </div>
        <div class="stat-icon amber"><i class="fi fi-sr-clock"></i></div>
    </div>
    <div class="stat-card">
        <div class="stat-info">
            <h3>Expirados</h3>
            <div class="stat-value">@expirados</div>
            <span class="stat-change negative">Acima do prazo</span>
        </div>
        <div class="stat-icon red"><i class="fi fi-sr-calendar-xmark"></i></div>
    </div>
    <div class="stat-card">
        <div class="stat-info">
            <h3>Renovações Pendentes</h3>
            <div class="stat-value">@renovacoesPendentes</div>
            <span class="stat-change neutral">Aguardando decisão</span>
        </div>
        <div class="stat-icon green"><i class="fi fi-sr-refresh"></i></div>
    </div>
</div>

<!-- Alerta de Expirações -->
@if (alertas.Any())
{
    <div class="card" style="border-left:4px solid var(--danger);margin-bottom:1.5rem;">
        <div class="card-header">
            <div style="display:flex;align-items:center;gap:0.5rem;">
                <i class="fi fi-sr-triangle-exclamation" style="color:var(--danger);"></i>
                <span class="card-title">Alertas de Expiração</span>
            </div>
            <span class="badge badge-danger">@alertas.Count contrato@(alertas.Count > 1 ? "s" : "")</span>
        </div>
        <div class="card-body" style="display:flex;flex-direction:column;gap:0.75rem;">
            @foreach (var c in alertas)
            {
                var dias = c.DataFim!.Value.DayNumber - hoje.DayNumber;
                <div style="display:flex;align-items:center;justify-content:space-between;padding:0.75rem 1rem;border:1px solid var(--border);border-radius:0.5rem;background:rgba(239,68,68,0.02);">
                    <div style="display:flex;align-items:center;gap:0.75rem;">
                        <div class="stat-icon red" style="width:36px;height:36px;border-radius:50%;font-size:0.8rem;">
                            <i class="fi fi-sr-clock"></i>
                        </div>
                        <div>
                            <div style="font-weight:600;font-size:0.85rem;">@c.Colaborador?.NomeCompleto</div>
                            <div style="font-size:0.75rem;color:var(--text-secondary);">Expira em @c.DataFim.Value.ToString("dd/MM/yyyy") — <strong style="color:var(--danger);">@dias dia@(dias > 1 ? "s" : "")</strong></div>
                        </div>
                    </div>
                    <form asp-action="RenovarContrato" asp-route-id="@c.IdContrato" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger">Renovar</button>
                    </form>
                </div>
            }
        </div>
    </div>
}

<!-- Tabela de Contratos -->
<div class="card">
    <div class="card-header">
        <span class="card-title">Lista de Contratos</span>
        <div style="display:flex;gap:0.5rem;align-items:center;">
            <select class="form-select" id="filtroEstadoContrato" style="width:auto;padding:0.375rem 0.75rem;font-size:0.8rem;">
                <option value="">Todos os Estados</option>
                <option value="Vigente">Vigente</option>
                <option value="Expirado">Expirado</option>
                <option value="Rescindido">Rescindido</option>
                <option value="Rascunho">Rascunho</option>
            </select>
        </div>
    </div>
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Nº Contrato</th>
                    <th>Colaborador</th>
                    <th>Tipo</th>
                    <th>Data Início</th>
                    <th>Data Fim</th>
                    <th>Remuneração</th>
                    <th>Estado</th>
                    <th>Dias Rest.</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody id="tabelaContratos">
                @foreach (var c in Model)
                {
                    var dias = c.DataFim.HasValue ? c.DataFim.Value.DayNumber - hoje.DayNumber : 0;
                    var estadoLower = c.Estado.ToLower();
                    <tr data-estado="@c.Estado">
                        <td><strong>@c.NumeroContrato</strong></td>
                        <td>@c.Colaborador?.NomeCompleto</td>
                        <td><span style="font-size:0.75rem;">@c.TipoContrato?.Nome</span></td>
                        <td>@c.DataInicio.ToString("dd/MM/yyyy")</td>
                        <td>@(c.DataFim.HasValue ? c.DataFim.Value.ToString("dd/MM/yyyy") : "—")</td>
                        <td>@(c.Remuneracao.HasValue ? string.Format(new System.Globalization.CultureInfo("pt-MZ"), "{0:C}", c.Remuneracao.Value) : "—")</td>
                        <td><span class="badge @GetBadgeEstado(c.Estado)">@c.Estado</span></td>
                        <td>
                            @if (c.DataFim.HasValue)
                            {
                                if (dias < 0)
                                {
                                    <span style="color:var(--danger);">@Math.Abs(dias)d exp.</span>
                                }
                                else if (dias == 0)
                                {
                                    <span style="color:var(--danger);">Hoje</span>
                                }
                                else
                                {
                                    @($"{dias}d")
                                }
                            }
                            else
                            {
                                @:—
                            }
                        </td>
                        <td>
                            <div style="display:flex;gap:0.25rem;">
                                <button class="btn btn-icon btn-outline" title="Editar" onclick="abrirEditar(@c.IdContrato, '@c.Colaborador?.NomeCompleto', @c.IdTipoContrato, '@c.Estado', '@c.DataInicio.ToString("yyyy-MM-dd")', '@(c.DataFim.HasValue ? c.DataFim.Value.ToString("yyyy-MM-dd") : "")', '@(c.Remuneracao.HasValue ? c.Remuneracao.Value.ToString("F2") : "")', '@c.Objecto')"><i class="fi fi-sr-pencil"></i></button>
                                <button class="btn btn-icon btn-outline" title="Eliminar" onclick="abrirEliminar(@c.IdContrato, '@c.NumeroContrato', '@c.Colaborador?.NomeCompleto')" style="color:var(--danger);cursor:pointer;"><i class="fi fi-sr-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Editar Contrato -->
<div class="modal-overlay" id="modalEditarContrato">
    <div class="modal">
        <div class="modal-header">
            <span class="modal-title">Editar Contrato</span>
            <button class="modal-close" onclick="fecharModal('modalEditarContrato')"><i class="fi fi-sr-xmark"></i></button>
        </div>
        <form asp-action="EditarContrato" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <input type="hidden" name="IdContrato" id="editarContratoId">
                <div class="form-group">
                    <label class="form-label">Colaborador</label>
                    <input type="text" class="form-input" id="editarColaborador" readonly>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Tipo de Contrato <span style="color:var(--danger);">*</span></label>
                        <select class="form-select" name="IdTipoContrato" id="editarTipo" required>
                            @foreach (var tc in (IEnumerable<SGRH.Models.TipoContrato>)ViewBag.TiposContrato)
                            {
                                <option value="@tc.IdTipoContrato">@tc.Nome</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Estado</label>
                        <select class="form-select" name="estadoContrato" id="editarEstado">
                            <option value="Vigente">Vigente</option>
                            <option value="Expirado">Expirado</option>
                            <option value="Rescindido">Rescindido</option>
                            <option value="Rascunho">Rascunho</option>
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Data de Início <span style="color:var(--danger);">*</span></label>
                        <input type="date" class="form-input" name="DataInicio" id="editarDataInicio" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Data de Fim</label>
                        <input type="date" class="form-input" name="DataFim" id="editarDataFim">
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Remuneração (MZN)</label>
                    <input type="number" class="form-input" name="Remuneracao" id="editarRemuneracao" step="0.01" min="0">
                </div>
                <div class="form-group">
                    <label class="form-label">Objecto</label>
                    <textarea class="form-textarea" name="Objecto" id="editarObjecto" rows="3" style="resize:vertical;"></textarea>
                </div>

                <h4 style="font-size:0.9rem;font-weight:600;margin:1rem 0 0.75rem;padding-bottom:0.5rem;border-bottom:1px solid var(--border-color);">Documentos</h4>
                <div class="form-group">
                    <input type="file" id="docsEditar" name="documentos" multiple accept=".pdf,.docx,.doc,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/msword" style="display:none;" onchange="adicionarDocumentosEditar(this)">
                    <div id="areaUploadEditar" style="border:2px dashed var(--border-color);border-radius:8px;padding:1.5rem;text-align:center;background:var(--bg-secondary);cursor:pointer;transition:all 0.2s;" onmouseover="this.style.borderColor='var(--primary)'" onmouseout="this.style.borderColor='var(--border-color)'" onclick="document.getElementById('docsEditar').click()">
                        <i class="fi fi-sr-cloud-upload" style="font-size:1.5rem;color:var(--primary);margin-bottom:0.25rem;display:block;"></i>
                        <p style="font-size:0.8rem;color:var(--text-secondary);margin:0;font-weight:500;">Arraste ficheiros ou clique para selecionar</p>
                        <p style="font-size:0.7rem;color:var(--text-muted);margin:0.2rem 0 0;">PDF ou Word (.docx, .doc). Máx 10MB.</p>
                    </div>
                    <div id="listaDocumentosEditar" style="margin-top:0.75rem;"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" onclick="fecharModal('modalEditarContrato')">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar Alterações</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Eliminar Contrato -->
<div class="modal-overlay" id="modalDeleteContrato">
    <div class="modal">
        <div class="modal-header">
            <span class="modal-title" style="color:var(--danger);">Eliminar Contrato</span>
            <button class="modal-close" onclick="fecharModal('modalDeleteContrato')"><i class="fi fi-sr-xmark"></i></button>
        </div>
        <div class="modal-body">
            <div style="text-align:center;padding:1rem 0;">
                <i class="fi fi-sr-trash-xmark" style="font-size:2.5rem;color:var(--danger);margin-bottom:0.75rem;display:block;"></i>
                <p style="font-size:0.95rem;color:var(--text-primary);margin-bottom:0.25rem;">Tem certeza que deseja eliminar este contrato?</p>
                <p id="mensagemDeleteContrato" style="font-size:0.85rem;color:var(--text-secondary);"></p>
            </div>
        </div>
        <div class="modal-footer">
            <form asp-action="EliminarContrato" method="post" style="display:flex;gap:0.5rem;justify-content:flex-end;width:100%;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteContratoId">
                <button type="button" class="btn btn-outline" onclick="fecharModal('modalDeleteContrato')">Cancelar</button>
                <button type="submit" class="btn btn-danger">Eliminar</button>
            </form>
        </div>
    </div>
</div>

@functions {
    string GetBadgeEstado(string estado) => estado switch
    {
        "Vigente" => "badge-success",
        "Expirado" => "badge-danger",
        "Rescindido" => "badge-danger",
        "Rascunho" => "badge-gray",
        _ => "badge-gray"
    };
}

@section Scripts {
<script>
$(document).ready(function() {
    $('#filtroEstadoContrato').on('change', function() {
        var filtro = $(this).val();
        $('#tabelaContratos tr').each(function() {
            var $row = $(this);
            if (!filtro || $row.data('estado') === filtro) {
                $row.show();
            } else {
                $row.hide();
            }
        });
    });
});

function abrirEditar(id, colaborador, idTipo, estado, dataInicio, dataFim, remuneracao, objecto) {
    $('#editarContratoId').val(id);
    $('#editarColaborador').val(colaborador);
    $('#editarTipo').val(idTipo);
    $('#editarEstado').val(estado);
    $('#editarDataInicio').val(dataInicio);
    $('#editarDataFim').val(dataFim);
    $('#editarRemuneracao').val(remuneracao);
    $('#editarObjecto').val(objecto || '');
    $('#listaDocumentosEditar').empty();
    $('#modalEditarContrato').addClass('active');
}

function processarFicheirosEditar(files) {
    var extensoesPermitidas = ['.pdf', '.docx', '.doc'];
    for (var i = 0; i < files.length; i++) {
        var file = files[i];
        var ext = '.' + file.name.split('.').pop().toLowerCase();
        if (extensoesPermitidas.indexOf(ext) === -1) {
            showToast('Formato não suportado no ficheiro "' + file.name + '".', 'warning');
            continue;
        }
        if (file.size > 10 * 1024 * 1024) {
            showToast('O ficheiro "' + file.name + '" excede o limite de 10MB.', 'warning');
            continue;
        }
        var icon = 'fi fi-sr-document';
        if (ext === '.pdf') icon = 'fi fi-sr-file-pdf';
        else if (ext === '.docx' || ext === '.doc') icon = 'fi fi-sr-file-word';

        var tamanho = file.size < 1024 * 1024
            ? (file.size / 1024).toFixed(1) + ' KB'
            : (file.size / (1024 * 1024)).toFixed(1) + ' MB';

        var item = '<div style="display:flex;align-items:center;gap:0.75rem;padding:0.5rem 0.75rem;background:var(--bg-secondary);border:1px solid var(--border-color);border-radius:6px;margin-bottom:0.4rem;">' +
            '<i class="' + icon + '" style="font-size:1.2rem;color:var(--primary);"></i>' +
            '<div style="flex:1;min-width:0;">' +
                '<div style="font-size:0.8rem;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="' + file.name + '">' + file.name + '</div>' +
                '<div style="font-size:0.7rem;color:var(--text-muted);">' + tamanho + '</div>' +
            '</div>' +
        '</div>';
        $('#listaDocumentosEditar').append(item);
    }
}

function adicionarDocumentosEditar(input) {
    if (input.files && input.files.length > 0) {
        processarFicheirosEditar(input.files);
    }
}

$(document).ready(function() {
    var dropArea = document.getElementById('areaUploadEditar');
    if (dropArea) {
        ['dragenter', 'dragover'].forEach(function(eventName) {
            dropArea.addEventListener(eventName, function(e) {
                e.preventDefault();
                e.stopPropagation();
                dropArea.style.borderColor = 'var(--primary)';
                dropArea.style.background = 'var(--bg-hover)';
            }, false);
        });
        ['dragleave', 'drop'].forEach(function(eventName) {
            dropArea.addEventListener(eventName, function(e) {
                e.preventDefault();
                e.stopPropagation();
                dropArea.style.borderColor = 'var(--border-color)';
                dropArea.style.background = 'var(--bg-secondary)';
            }, false);
        });
        dropArea.addEventListener('drop', function(e) {
            var dt = e.dataTransfer;
            if (dt && dt.files && dt.files.length > 0) {
                processarFicheirosEditar(dt.files);
            }
        }, false);
    }
});

function abrirEliminar(id, numero, colaborador) {
    $('#deleteContratoId').val(id);
    $('#mensagemDeleteContrato').html('Contrato <strong>' + numero + '</strong> — ' + colaborador);
    $('#modalDeleteContrato').addClass('active');
}

function fecharModal(id) {
    $('#' + id).removeClass('active');
}
</script>
}
