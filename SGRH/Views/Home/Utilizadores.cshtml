@{
    ViewData["Title"] = "Utilizadores";
    var perfis = ViewBag.Perfis as List<SGRH.Models.PerfilAcesso> ?? [];
    var colaboradores = ViewBag.Colaboradores as dynamic;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Gestão de Utilizadores</h1>
        <p class="page-subtitle">Perfis de acesso e controlo de permissões</p>
    </div>
    <a href="@Url.Action("NovoUtilizador", "Home")" class="btn btn-primary"><i class="fi fi-sr-plus"></i> Novo Utilizador</a>
</div>

<!-- KPIs -->
<div class="stats-grid" style="margin-bottom:1.5rem;">
    <div class="stat-card"><div class="stat-info"><h3>Total Utilizadores</h3><div class="stat-value" id="kpiTotal">0</div></div><div class="stat-icon blue"><i class="fi fi-sr-users"></i></div></div>
    <div class="stat-card"><div class="stat-info"><h3>Activos</h3><div class="stat-value" id="kpiActivos" style="color:var(--success);">0</div></div><div class="stat-icon green"><i class="fi fi-sr-check-circle"></i></div></div>
    <div class="stat-card"><div class="stat-info"><h3>Inactivos</h3><div class="stat-value" id="kpiInactivos" style="color:var(--danger);">0</div></div><div class="stat-icon red"><i class="fi fi-sr-user-xmark"></i></div></div>
    <div class="stat-card"><div class="stat-info"><h3>Perfis</h3><div class="stat-value" id="kpiPerfis">0</div></div><div class="stat-icon amber"><i class="fi fi-sr-user-shield"></i></div></div>
</div>

<!-- ComboBox Filtrar por Perfil -->
<div class="card" style="margin-bottom:1.5rem;">
    <div class="card-body" style="padding:1rem 1.25rem;display:flex;align-items:center;gap:1rem;flex-wrap:wrap;">
        <div style="display:flex;align-items:center;gap:0.5rem;">
            <i class="fi fi-sr-filter" style="color:var(--primary-light);font-size:1rem;"></i>
            <span style="font-weight:600;font-size:0.85rem;color:var(--text-primary);">Filtrar por perfil:</span>
        </div>
        <select class="form-select" id="comboPerfil" style="min-width:260px;max-width:360px;">
            <option value="todos">Todos os perfis</option>
            @foreach (var p in perfis)
            {
                <option value="@p.Nome">@p.Nome — @p.Descricao</option>
            }
        </select>
        <span style="font-size:0.8rem;color:var(--text-muted);" id="perfilCount"></span>
    </div>
</div>

<!-- Tabela -->
<div class="card">
    <div class="card-body" style="padding:0;">
        <div class="table-container">
            <table>
                <thead><tr><th>Utilizador</th><th>Perfil</th><th>Colaborador Vinculado</th><th>Último Acesso</th><th>Estado</th><th style="text-align:right;">Ações</th></tr></thead>
                <tbody id="tabelaUtilizadores"></tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Editar Utilizador -->
<div class="modal-overlay" id="modalEditarUtil">
    <div class="modal">
        <div class="modal-header"><h2 class="modal-title">Editar Utilizador</h2><button class="modal-close" id="closeEditarUtil">&times;</button></div>
        <div class="modal-body">
            <input type="hidden" id="editUtilId">
            <div class="form-row">
                <div class="form-group"><label class="form-label">Nome de Utilizador</label><input class="form-input" type="text" id="editUtilUsername" readonly style="background:var(--bg-body);"></div>
                <div class="form-group"><label class="form-label">Email</label><input class="form-input" type="email" id="editUtilEmail"></div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Perfil de Acesso</label>
                    <select class="form-select" id="editUtilPerfil">
                        @foreach (var p in perfis)
                        {
                            <option value="@p.IdPerfil">@p.Nome</option>
                        }
                    </select>
                </div>
                <div class="form-group"><label class="form-label">Estado</label><select class="form-select" id="editUtilEstado"><option value="Ativo">Activo</option><option value="Inativo">Inactivo</option></select></div>
            </div>
            <div class="form-group"><label class="form-label">Nova Senha (deixar vazio para manter)</label><input class="form-input" type="password" id="editUtilPassword" placeholder="••••••••"></div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" id="cancelEditarUtil">Cancelar</button>
            <button class="btn btn-primary" id="guardarEditarUtil"><i class="fi fi-sr-check"></i> Guardar</button>
        </div>
    </div>
</div>

<!-- Modal: Eliminar Utilizador -->
<div class="modal-overlay" id="modalDeleteUtil">
    <div class="modal" style="max-width:440px;">
        <div class="modal-header" style="background:rgba(239,68,68,0.03);">
            <h2 class="modal-title" style="color:var(--danger);">Eliminar Utilizador</h2>
            <button class="modal-close" id="closeDeleteUtil">&times;</button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="deleteUtilId">
            <div style="display:flex;gap:1rem;align-items:center;">
                <div style="width:48px;height:48px;border-radius:50%;background:rgba(239,68,68,0.1);display:flex;align-items:center;justify-content:center;"><i class="fi fi-sr-trash" style="color:var(--danger);font-size:1.25rem;"></i></div>
                <div><p style="font-weight:600;">Eliminar utilizador?</p><p style="font-size:0.8rem;color:var(--text-muted);" id="deleteUtilMsg">O utilizador perderá acesso imediatamente.</p></div>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" id="cancelDeleteUtil">Cancelar</button>
            <button class="btn btn-danger" id="confirmDeleteUtil"><i class="fi fi-sr-trash"></i> Eliminar</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
var perfilBadgeClass = { 'Administrador': 'admin', 'RH': 'rh', 'Gestor': 'gestor', 'Direccao': 'gestor', 'Funcionario': 'fae', 'Juri': '', 'Juridico': '', 'Formador': '', 'Supervisor': '', 'Estagiario': '', 'Candidato': '', 'InstituicaoEnsino': '', 'TI': '' };
var utilizadores = [];
var filtroUtilPerfil = 'todos';

function formatarData(dt) {
    if (!dt) return '—';
    var d = new Date(dt);
    var dia = String(d.getDate()).padStart(2,'0');
    var mes = String(d.getMonth()+1).padStart(2,'0');
    var ano = d.getFullYear();
    var hora = String(d.getHours()).padStart(2,'0');
    var min = String(d.getMinutes()).padStart(2,'0');
    return dia+'/'+mes+'/'+ano+' '+hora+':'+min;
}

function getBadgeEstado(e) {
    return e === 'Ativo' ? 'badge-success' : 'badge-danger';
}

function renderizarTabela(dados) {
    var $tbody = $('#tabelaUtilizadores');
    $tbody.empty();
    if (!dados || dados.length === 0) {
        $tbody.append('<tr><td colspan="6"><div class="empty-state"><h3>Nenhum utilizador encontrado</h3><p>Nao existe nenhum utilizador para a pesquisa efectuada.</p></div></td></tr>');
        return;
    }
    $.each(dados, function(i, u) {
        var initials = u.username.charAt(0).toUpperCase() + (u.username.split('.')[1] ? u.username.split('.')[1].charAt(0).toUpperCase() : '');
        $tbody.append(
            '<tr><td><div class="table-user"><div class="table-avatar">' + initials + '</div><div class="table-user-info"><div class="name">' + u.username + '</div><div class="sub">' + u.email + '</div></div></div></td>' +
            '<td><span class="role-badge ' + (perfilBadgeClass[u.perfil]||'') + '"><i class="fi fi-sr-user-shield"></i> ' + u.perfil + '</span></td>' +
            '<td>' + (u.colaborador || '—') + '</td>' +
            '<td style="font-size:0.8rem;">' + formatarData(u.ultimoAcesso) + '</td>' +
            '<td><span class="badge ' + getBadgeEstado(u.estado) + '">' + u.estado + '</span></td>' +
            '<td style="text-align:right;">' +
            '<button class="btn btn-sm btn-outline" data-edit-util="' + u.id + '" title="Editar"><i class="fi fi-sr-pencil"></i></button> ' +
            '<button class="btn btn-sm btn-outline" data-delete-util="' + u.id + '" title="Eliminar" style="color:var(--danger);"><i class="fi fi-sr-trash"></i></button>' +
            '</td></tr>'
        );
    });
    $('#perfilCount').text(dados.length + ' utilizador(es)');
}

function aplicarFiltros() {
    var termo = $('#pesquisarGeral').val().toLowerCase().trim();
    var dados = utilizadores;

    if (filtroUtilPerfil !== 'todos') {
        dados = dados.filter(function(u){ return u.perfil === filtroUtilPerfil; });
    }

    if (termo) {
        dados = dados.filter(function(u) {
            return (u.username && u.username.toLowerCase().indexOf(termo) !== -1)
                || (u.email && u.email.toLowerCase().indexOf(termo) !== -1)
                || (u.colaborador && u.colaborador.toLowerCase().indexOf(termo) !== -1)
                || (u.perfil && u.perfil.toLowerCase().indexOf(termo) !== -1);
        });
    }

    renderizarTabela(dados);
}

function carregarUtilizadores() {
    $.get('/Home/ObterUtilizadores', function(data) {
        utilizadores = data;
        $('#kpiTotal').text(data.length);
        $('#kpiActivos').text(data.filter(function(u){ return u.estado === 'Ativo'; }).length);
        $('#kpiInactivos').text(data.filter(function(u){ return u.estado !== 'Ativo'; }).length);
        $('#kpiPerfis').text([...new Set(data.map(function(u){ return u.perfil; }))].length);
        aplicarFiltros();
    });
}

$(document).ready(function() {
    carregarUtilizadores();

    // ComboBox filtro por perfil
    $('#comboPerfil').on('change', function() {
        filtroUtilPerfil = $(this).val();
        aplicarFiltros();
    });

    // Pesquisa instantanea via topbar
    $('#pesquisarGeral').on('input', aplicarFiltros);

    // Editar
    $(document).on('click', '[data-edit-util]', function() {
        var id = parseInt($(this).data('edit-util'));
        var u = utilizadores.find(function(usr){ return usr.id === id; });
        if (!u) return;
        $('#editUtilId').val(u.id);
        $('#editUtilUsername').val(u.username);
        $('#editUtilEmail').val(u.email);
        $('#editUtilPerfil').val(u.idPerfil);
        $('#editUtilEstado').val(u.estado);
        $('#editUtilPassword').val('');
        openModal('modalEditarUtil');
    });

    $('#guardarEditarUtil').on('click', function() {
        var dados = {
            id: parseInt($('#editUtilId').val()),
            email: $('#editUtilEmail').val(),
            idPerfil: parseInt($('#editUtilPerfil').val()),
            estado: $('#editUtilEstado').val(),
            password: $('#editUtilPassword').val() || null
        };
        $.ajax({
            url: '/Home/AtualizarUtilizador',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(dados),
            success: function(resp) {
                if (resp.sucesso) {
                    closeModal('modalEditarUtil');
                    carregarUtilizadores();
                }
                showToast(resp.mensagem, resp.sucesso ? 'success' : 'error');
            }
        });
    });
    $('#closeEditarUtil, #cancelEditarUtil').on('click', function() { closeModal('modalEditarUtil'); });

    // Eliminar
    $(document).on('click', '[data-delete-util]', function() {
        var id = parseInt($(this).data('delete-util'));
        var u = utilizadores.find(function(usr){ return usr.id === id; });
        if (!u) return;
        $('#deleteUtilId').val(u.id);
        $('#deleteUtilMsg').text('Eliminar o utilizador ' + u.username + '? O utilizador perderá acesso imediatamente.');
        openModal('modalDeleteUtil');
    });

    $('#confirmDeleteUtil').on('click', function() {
        var id = parseInt($('#deleteUtilId').val());
        $.ajax({
            url: '/Home/EliminarUtilizador',
            type: 'POST',
            data: { id: id },
            success: function(resp) {
                closeModal('modalDeleteUtil');
                carregarUtilizadores();
                showToast(resp.mensagem, resp.sucesso ? 'success' : 'error');
            }
        });
    });
    $('#closeDeleteUtil, #cancelDeleteUtil').on('click', function() { closeModal('modalDeleteUtil'); });
});
</script>
}
