@{
    ViewData["Title"] = "Administração de Pessoal";
    Layout = "_Layout";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>Administração de Pessoal</h2>
            <p class="text-muted">Assiduidade, workflow de aprovação e gestão administrativa</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary" id="btnMapaAssiduidade">
                <i class="bi bi-calendar3"></i> Mapa Assiduidade
            </button>
            <button class="btn btn-primary" id="btnNovoPedido">
                <i class="bi bi-plus-circle"></i> Novo Pedido
            </button>
        </div>
    </div>

    <ul class="nav nav-tabs" id="tabsAdmin" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" data-tab="workflow">Workflow</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-tab="calendario">Calendário</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-tab="assiduidade">Assiduidade</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-tab="ausencias">Ausências</button>
        </li>
    </ul>

    <div class="tab-content mt-3">
        <!-- Tab: Workflow -->
        <div class="tab-pane active" id="tab-workflow">
            <div class="row mb-3">
                <div class="col-md-3">
                    <div class="card text-bg-warning">
                        <div class="card-body text-center">
                            <h5 class="card-title">Pedidos Pendentes</h5>
                            <h2>3</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-bg-info">
                        <div class="card-body text-center">
                            <h5 class="card-title">Em Análise</h5>
                            <h2>2</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-bg-success">
                        <div class="card-body text-center">
                            <h5 class="card-title">Aprovados</h5>
                            <h2>8</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-bg-danger">
                        <div class="card-body text-center">
                            <h5 class="card-title">Rejeitados</h5>
                            <h2>1</h2>
                        </div>
                    </div>
                </div>
            </div>

