                    <tbody>
                        <tr>
                            <td>Carlos Machava</td>
                            <td>Férias</td>
                            <td><span class="badge bg-warning text-dark">Pendente</span></td>
                            <td>10/07/2026</td>
                            <td>
                                <button class="btn btn-sm btn-success" onclick="aprovarPedido($(this))">Aprovar</button>
                                <button class="btn btn-sm btn-danger" onclick="rejeitarPedido($(this))">Rejeitar</button>
