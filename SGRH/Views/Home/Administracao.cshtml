    { funcionario: "Ana Fernandes", tipo: "Dispensa", dataInicio: "05/07/2026", dataFim: "05/07/2026", motivo: "Assentamento de contas", estado: "Aprovada" },
    { funcionario: "Fátima Tembe", tipo: "Férias", dataInicio: "20/07/2026", dataFim: "24/07/2026", motivo: "Recesso familiar", estado: "Pendente" }
];

$(document).ready(function () {
    // Tab switching
    $('#tabsAdmin .nav-link').on('click', function () {
        var tab = $(this).data('tab');
        $('#tabsAdmin .nav-link').removeClass('active');
        $(this).addClass('active');
        $('.tab-pane').removeClass('active');
        $('#tab-' + tab).addClass('active');

        if (tab === 'calendario') {
            initCalendar();
        }
    });

    // Render ausências table
    renderAusenciasTable();

    // Open modals
    $('#btnNovoPedido').on('click', function () {
        var modal = new bootstrap.Modal(document.getElementById('modalNovoPedido'));
        modal.show();
    });

    $('#btnNovaAusencia').on('click', function () {
        var modal = new bootstrap.Modal(document.getElementById('modalNovaAusencia'));
        modal.show();
    });

    $('#btnMapaAssiduidade').on('click', function () {
        $('#tabsAdmin .nav-link').removeClass('active');
        $('#tabsAdmin .nav-link[data-tab="assiduidade"]').addClass('active');
        $('.tab-pane').removeClass('active');
        $('#tab-assiduidade').addClass('active');
    });

    // Submit handlers
    $('#submitNovoPedido').on('click', function () {
        var form = $('#formNovoPedido')[0];
        if (form.checkValidity()) {
            alert('Pedido submetido com sucesso!');
            bootstrap.Modal.getInstance(document.getElementById('modalNovoPedido')).hide();
            form.reset();
        } else {
            form.reportValidity();
        }
    });

    $('#submitNovaAusencia').on('click', function () {
        var form = $('#formNovaAusencia')[0];
        if (form.checkValidity()) {
            var novaAusencia = {
                funcionario: $('#ausenciaFuncionario').val(),
                tipo: $('#ausenciaTipo').val(),
                dataInicio: $('#ausenciaDataInicio').val(),
                dataFim: $('#ausenciaDataFim').val(),
                motivo: $('#ausenciaMotivo').val(),
                estado: "Pendente"
            };
            ausencias.push(novaAusencia);
            renderAusenciasTable();
            bootstrap.Modal.getInstance(document.getElementById('modalNovaAusencia')).hide();
            form.reset();
            alert('Ausência registada com sucesso!');
        } else {
            form.reportValidity();
        }
    });
});

// Calendar initialization
var calendarInitialized = false;
function initCalendar() {
    if (calendarInitialized) return;
    if (typeof FullCalendar === 'undefined') {
        console.warn('FullCalendar not loaded');
        return;
    }
    var calendarEl = document.getElementById('calendarAdmin');
    var calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        initialDate: '2026-07-01',
        locale: 'pt',
        headerToolbar: {
            left: 'prev,next today',
            center: 'title',
            right: 'dayGridMonth,timeGridWeek'
        },
        events: [
            { title: 'Carlos Machava - Férias', start: '2026-07-15', end: '2026-07-26', color: '#28a745' },
            { title: 'Pedro Cossa - Dia Médico', start: '2026-07-03', color: '#ffc107' },
            { title: 'Rosa Banze - Licença', start: '2026-07-14', end: '2026-07-17', color: '#17a2b8' },
            { title: 'Ana Fernandes - Dispensa', start: '2026-07-05', color: '#fd7e14' },
            { title: 'Fátima Tembe - Férias', start: '2026-07-20', end: '2026-07-25', color: '#28a745' }
        ]
    });
    calendar.render();
    calendarInitialized = true;
}

function renderAusenciasTable() {
    var $tbody = $('#tabelaAusencias tbody');
    $tbody.empty();
    $.each(ausencias, function (i, a) {
        var estadoClass = a.estado === 'Aprovada' ? 'bg-success' : a.estado === 'Pendente' ? 'bg-warning text-dark' : 'bg-danger';
        var row = '<tr>' +
            '<td>' + a.funcionario + '</td>' +
            '<td>' + a.tipo + '</td>' +
            '<td>' + a.dataInicio + '</td>' +
            '<td>' + a.dataFim + '</td>' +
            '<td>' + a.motivo + '</td>' +
            '<td><span class="badge ' + estadoClass + '">' + a.estado + '</span></td>' +
            '</tr>';
        $tbody.append(row);
    });
}

function aprovarPedido($btn) {
    var $row = $btn.closest('tr');
    $row.find('td:eq(2)').html('<span class="badge bg-success">Aprovado</span>');
    $row.find('td:eq(4)').html('<span class="text-success"><i class="bi bi-check-circle"></i> Processado</span>');
}

function rejeitarPedido($btn) {
    var $row = $btn.closest('tr');
    $row.find('td:eq(2)').html('<span class="badge bg-danger">Rejeitado</span>');
    $row.find('td:eq(4)').html('<span class="text-danger"><i class="bi bi-x-circle"></i> Rejeitado</span>');
}
</script>
}