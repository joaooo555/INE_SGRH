<!-- Modal: Novo Pedido -->
<div class="modal fade" id="modalNovoPedido" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Novo Pedido</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formNovoPedido">
                    <div class="mb-3">
                        <label for="pedidoFuncionario" class="form-label">Funcionário</label>
                        <select class="form-select" id="pedidoFuncionario" required>
                            <option value="">Selecionar...</option>
                            <option>Carlos Machava</option>
                            <option>Pedro Cossa</option>
                            <option>Rosa Banze</option>
                            <option>Ana Fernandes</option>
                            <option>Fátima Tembe</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="pedidoTipo" class="form-label">Tipo de Pedido</label>
                        <select class="form-select" id="pedidoTipo" required>
                            <option value="">Selecionar...</option>
                            <option>Férias</option>
                            <option>Licença</option>
                            <option>Dispensa</option>
                            <option>Assinatura</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="pedidoDataInicio" class="form-label">Data Início</label>
                        <input type="date" class="form-control" id="pedidoDataInicio" required>
                    </div>
                    <div class="mb-3">
                        <label for="pedidoDataFim" class="form-label">Data Fim</label>
                        <input type="date" class="form-control" id="pedidoDataFim" required>
                    </div>
                    <div class="mb-3">
                        <label for="pedidoObservacoes" class="form-label">Observações</label>
                        <textarea class="form-control" id="pedidoObservacoes" rows="3"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="submitNovoPedido">Submeter</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Nova Ausência -->
<div class="modal fade" id="modalNovaAusencia" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nova Ausência</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formNovaAusencia">
                    <div class="mb-3">
                        <label for="ausenciaFuncionario" class="form-label">Funcionário</label>
                        <select class="form-select" id="ausenciaFuncionario" required>
                            <option value="">Selecionar...</option>
                            <option>Carlos Machava</option>
                            <option>Pedro Cossa</option>
                            <option>Rosa Banze</option>
                            <option>Ana Fernandes</option>
                            <option>Fátima Tembe</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="ausenciaTipo" class="form-label">Tipo de Ausência</label>
                        <select class="form-select" id="ausenciaTipo" required>
                            <option value="">Selecionar...</option>
                            <option>Falta</option>
                            <option>Dia Médico</option>
                            <option>Férias</option>
                            <option>Licença</option>
                            <option>Dispensa</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="ausenciaDataInicio" class="form-label">Data Início</label>
                        <input type="date" class="form-control" id="ausenciaDataInicio" required>
                    </div>
                    <div class="mb-3">
                        <label for="ausenciaDataFim" class="form-label">Data Fim</label>
                        <input type="date" class="form-control" id="ausenciaDataFim" required>
                    </div>
                    <div class="mb-3">
                        <label for="ausenciaMotivo" class="form-label">Motivo</label>
                        <textarea class="form-control" id="ausenciaMotivo" rows="3" required></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="submitNovaAusencia">Registar</button>
            </div>
        </div>
    </div>
</div>

