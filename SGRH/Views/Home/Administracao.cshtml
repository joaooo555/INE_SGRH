@model AdministracaoPessoalViewModel
@{
    ViewData["Title"] = "Administração de Pessoal";
    Layout = "_Layout";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Administração de Pessoal</h1>
        <p class="page-subtitle">Gestão de férias, faltas e licenças — registo, actualização e workflow de aprovação</p>
    </div>
    <div style="display:flex;gap:0.75rem;">
        <button class="btn btn-outline" onclick="openModal('modalNovaAusencia')"><i class="fi fi-sr-plus"></i> Registar Ausência</button>
        <button class="btn btn-primary" onclick="openModal('modalNovoPedido')"><i class="fi fi-sr-file"></i> Novo Pedido</button>
    </div>
</div>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}
@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger">@TempData["Erro"]</div>
}

<!-- KPIs -->
<div class="stats-grid" style="margin-bottom:1.5rem;">
    <div class="stat-card"><div class="stat-info"><h3>Pedidos Pendentes</h3><div class="stat-value">@Model.PedidosAprovacao.Count(p => p.Estado == "Pendente")</div></div><div class="stat-icon amber"><i class="fi fi-sr-time-fast"></i></div></div>
    <div class="stat-card"><div class="stat-info"><h3>Aprovados</h3><div class="stat-value" style="color:var(--success);">@Model.PedidosAprovacao.Count(p => p.Estado == "Aprovado")</div></div><div class="stat-icon green"><i class="fi fi-sr-check-circle"></i></div></div>
    <div class="stat-card"><div class="stat-info"><h3>Rejeitados</h3><div class="stat-value" style="color:var(--danger);">@Model.PedidosAprovacao.Count(p => p.Estado == "Rejeitado")</div></div><div class="stat-icon red"><i class="fi fi-sr-cross-circle"></i></div></div>
    <div class="stat-card"><div class="stat-info"><h3>Registos de Ausência</h3><div class="stat-value">@Model.RegistosAusencia.Count</div></div><div class="stat-icon blue"><i class="fi fi-sr-calendar"></i></div></div>
</div>

<!-- Tabs -->
<div class="tabs" id="tabsAdmin">
    <button class="tab-item active" data-admintab="pedidos">Workflow de Aprovação</button>
    <button class="tab-item" data-admintab="ausencias">Assiduidade / Ausências</button>
    <button class="tab-item" data-admintab="tipos">Tipos</button>
</div>

<!-- TAB: Workflow de Aprovação -->
<div id="adm-pedidos">
    <div class="card">
        <div class="card-header">
            <span class="card-title"><i class="fi fi-sr-shield-check" style="color:var(--info);margin-right:0.5rem;"></i> Pedidos de Aprovação</span>
        </div>
        <div class="card-body" style="padding:0;">
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Colaborador</th>
                            <th>Tipo</th>
                            <th>Descrição</th>
                            <th>Submissão</th>
                            <th>Estado</th>
                            <th style="text-align:right;">Acções</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.PedidosAprovacao.Any())
                        {
                            <tr><td colspan="6" style="text-align:center;padding:2rem;color:var(--text-muted);">Sem pedidos submetidos.</td></tr>
                        }
                        @foreach (var p in Model.PedidosAprovacao)
                        {
                            var cls = p.Estado switch
                            {
                                "Aprovado" => "badge-success",
                                "Rejeitado" => "badge-danger",
                                _ => "badge-warning"
                            };
                            <tr>
                                <td>@p.Colaborador.NomeCompleto</td>
                                <td><span class="chip">@p.TipoPedido.Nome</span></td>
                                <td style="max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@p.Descricao">@p.Descricao</td>
                                <td style="white-space:nowrap;">@p.DataSubmissao.ToString("dd/MM/yyyy HH:mm")</td>
                                <td><span class="badge @cls">@p.Estado</span></td>
                                <td style="text-align:right;white-space:nowrap;">
                                    @if (p.Estado == "Pendente")
                                    {
                                        <form method="post" asp-controller="Home" asp-action="MudarEstadoPedido" style="display:inline;" onsubmit="return confirm('Aprovar o pedido de @p.Colaborador.NomeCompleto?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.IdPedido" />
                                            <input type="hidden" name="estado" value="Aprovado" />
                                            <button class="btn btn-sm btn-success" title="Aprovar pedido"><i class="fi fi-sr-check"></i> Aprovar</button>
                                        </form>
                                        <form method="post" asp-controller="Home" asp-action="MudarEstadoPedido" style="display:inline;" onsubmit="return confirm('Rejeitar o pedido de @p.Colaborador.NomeCompleto?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.IdPedido" />
                                            <input type="hidden" name="estado" value="Rejeitado" />
                                            <button class="btn btn-sm btn-danger" title="Rejeitar pedido"><i class="fi fi-sr-xmark"></i> Rejeitar</button>
                                        </form>
                                        <button class="btn btn-sm btn-outline" onclick='abrirDecisao(@System.Text.Json.JsonSerializer.Serialize(new { id = p.IdPedido, nome = p.Colaborador.NomeCompleto, tipo = p.TipoPedido.Nome }))' title="Decidir com parecer"><i class="fi fi-sr-pencil"></i> Parecer</button>
                                    }
                                    @if (p.Estado != "Pendente")
                                    {
                                        <form method="post" asp-controller="Home" asp-action="MudarEstadoPedido" style="display:inline;" onsubmit="return confirm('Reabrir este pedido como Pendente?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.IdPedido" />
                                            <input type="hidden" name="estado" value="Pendente" />
                                            <button class="btn btn-sm btn-outline" title="Reabrir como Pendente"><i class="fi fi-sr-undo"></i> Pendente</button>
                                        </form>
                                    }
                                    <form method="post" asp-controller="Home" asp-action="EliminarPedido" style="display:inline;" onsubmit="return confirm('Eliminar este pedido?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.IdPedido" />
                                        <button class="btn btn-sm btn-outline" title="Eliminar" style="color:var(--danger);"><i class="fi fi-sr-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- TAB: Ausências -->
<div id="adm-ausencias" style="display:none;">
    <div class="card">
        <div class="card-header">
            <span class="card-title"><i class="fi fi-sr-calendar" style="color:var(--info);margin-right:0.5rem;"></i> Registos de Ausência (férias, faltas, licenças)</span>
        </div>
        <div class="card-body" style="padding:0;">
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Colaborador</th>
                            <th>Tipo</th>
                            <th>Período</th>
                            <th>Dias</th>
                            <th>Motivo</th>
                            <th>Estado</th>
                            <th style="text-align:right;">Acções</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RegistosAusencia.Any())
                        {
                            <tr><td colspan="7" style="text-align:center;padding:2rem;color:var(--text-muted);">Sem registos de ausência.</td></tr>
                        }
                        @foreach (var r in Model.RegistosAusencia)
                        {
                            var dias = (r.DataFim.DayNumber - r.DataInicio.DayNumber) + 1;
                            var cls = r.Estado switch
                            {
                                "Aprovado" => "badge-success",
                                "Rejeitado" => "badge-danger",
                                "Cancelado" => "badge-gray",
                                _ => "badge-warning"
                            };
                            <tr>
                                <td>@r.Colaborador.NomeCompleto</td>
                                <td><span class="chip">@r.TipoAusencia.Nome</span></td>
                                <td style="white-space:nowrap;">@r.DataInicio.ToString("dd/MM/yy") — @r.DataFim.ToString("dd/MM/yy")</td>
                                <td>@dias</td>
                                <td style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@r.Motivo">@(r.Motivo ?? "—")</td>
                                <td><span class="badge @cls">@r.Estado</span></td>
                                <td style="text-align:right;white-space:nowrap;">
                                    <button class="btn btn-sm btn-outline" onclick='abrirEditarAusencia(@System.Text.Json.JsonSerializer.Serialize(new { id = r.IdRegisto, idTipo = r.IdTipoAusencia, inicio = r.DataInicio.ToString("yyyy-MM-dd"), fim = r.DataFim.ToString("yyyy-MM-dd"), motivo = r.Motivo, estado = r.Estado }))' title="Editar"><i class="fi fi-sr-pencil"></i></button>
                                    <form method="post" asp-controller="Home" asp-action="EliminarAusencia" style="display:inline;" onsubmit="return confirm('Eliminar este registo de ausência?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.IdRegisto" />
                                        <button class="btn btn-sm btn-outline" title="Eliminar" style="color:var(--danger);"><i class="fi fi-sr-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- TAB: Tipos -->
<div id="adm-tipos" style="display:none;">
    <div class="card">
        <div class="card-header">
            <span class="card-title"><i class="fi fi-sr-tags" style="color:var(--info);margin-right:0.5rem;"></i> Tipos de Ausência</span>
            <button class="btn btn-sm btn-primary" onclick="openModal('modalNovoTipo')"><i class="fi fi-sr-plus"></i> Novo Tipo</button>
        </div>
        <div class="card-body" style="padding:0;">
            <div class="table-container">
                <table>
                    <thead><tr><th>Nome</th><th>Descrição</th><th>Dias Máximos</th><th>Registos Associados</th><th style="text-align:right;">Acções</th></tr></thead>
                    <tbody>
                        @foreach (var t in Model.TiposAusencia)
                        {
                            <tr>
                                <td><strong>@t.Nome</strong></td>
                                <td>@(t.Descricao ?? "—")</td>
                                <td>@(t.DiasMaximos?.ToString() ?? "—")</td>
                                <td>@Model.RegistosAusencia.Count(r => r.IdTipoAusencia == t.IdTipoAusencia)</td>
                                <td style="text-align:right;">
                                    <form method="post" asp-controller="Home" asp-action="EliminarTipoAusencia" onsubmit="return confirm('Eliminar o tipo @t.Nome?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@t.IdTipoAusencia" />
                                        <button class="btn btn-sm btn-outline" style="color:var(--danger);"><i class="fi fi-sr-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card" style="margin-top:1.5rem;">
        <div class="card-header"><span class="card-title"><i class="fi fi-sr-tags" style="color:var(--info);margin-right:0.5rem;"></i> Tipos de Pedido</span></div>
        <div class="card-body" style="padding:0;">
            <div class="table-container">
                <table>
                    <thead><tr><th>Nome</th><th>Pedidos Associados</th></tr></thead>
                    <tbody>
                        @foreach (var t in Model.TiposPedido)
                        {
                            <tr><td><strong>@t.Nome</strong></td><td>@Model.PedidosAprovacao.Count(p => p.IdTipoPedido == t.IdTipoPedido)</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Nova Ausência -->
<div class="modal-overlay" id="modalNovaAusencia">
    <div class="modal">
        <div class="modal-header"><h2 class="modal-title">Registar Ausência</h2><button class="modal-close" onclick="closeModal('modalNovaAusencia')">&times;</button></div>
        <form method="post" asp-controller="Home" asp-action="CriarAusencia" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <div class="form-row">
                    <div class="form-group"><label class="form-label">Colaborador *</label>
                        <select class="form-select" name="idColaborador" required>
                            <option value="">Seleccionar...</option>
                            @foreach (var c in Model.Colaboradores)
                            {
                                <option value="@c.IdColaborador">@c.NomeCompleto</option>
                            }
                        </select>
                    </div>
                    <div class="form-group"><label class="form-label">Tipo de Ausência *</label>
                        <select class="form-select" name="idTipoAusencia" required>
                            <option value="">Seleccionar...</option>
                            @foreach (var t in Model.TiposAusencia)
                            {
                                <option value="@t.IdTipoAusencia">@t.Nome</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group"><label class="form-label">Data Início *</label><input class="form-input" type="date" name="dataInicio" required></div>
                    <div class="form-group"><label class="form-label">Data Fim *</label><input class="form-input" type="date" name="dataFim" required></div>
                </div>
                <div class="form-group"><label class="form-label">Motivo</label><textarea class="form-input" name="motivo" rows="2"></textarea></div>
                <div class="form-group"><label class="form-label">Documento de Suporte</label><input class="form-input" type="file" name="documento"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" onclick="closeModal('modalNovaAusencia')">Cancelar</button>
                <button type="submit" class="btn btn-primary"><i class="fi fi-sr-check"></i> Registar</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Editar Ausência -->
<div class="modal-overlay" id="modalEditarAusencia">
    <div class="modal">
        <div class="modal-header"><h2 class="modal-title">Editar Ausência</h2><button class="modal-close" onclick="closeModal('modalEditarAusencia')">&times;</button></div>
        <form method="post" asp-controller="Home" asp-action="EditarAusencia">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <div class="form-row">
                    <div class="form-group"><label class="form-label">Tipo</label>
                        <select class="form-select" name="idTipoAusencia" id="eaTipo">
                            @foreach (var t in Model.TiposAusencia)
                            {
                                <option value="@t.IdTipoAusencia">@t.Nome</option>
                            }
                        </select>
                    </div>
                    <div class="form-group"><label class="form-label">Estado</label>
                        <select class="form-select" name="estado" id="eaEstado">
                            <option>Pendente</option><option>Aprovado</option><option>Rejeitado</option><option>Cancelado</option>
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group"><label class="form-label">Data Início</label><input class="form-input" type="date" name="dataInicio" id="eaInicio" required></div>
                    <div class="form-group"><label class="form-label">Data Fim</label><input class="form-input" type="date" name="dataFim" id="eaFim" required></div>
                </div>
                <div class="form-group"><label class="form-label">Motivo</label><textarea class="form-input" name="motivo" id="eaMotivo" rows="2"></textarea></div>
            </div>
            <div class="modal-footer">
                <input type="hidden" name="id" id="eaId" />
                <button type="button" class="btn btn-outline" onclick="closeModal('modalEditarAusencia')">Cancelar</button>
                <button type="submit" class="btn btn-primary"><i class="fi fi-sr-check"></i> Guardar</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Novo Pedido -->
<div class="modal-overlay" id="modalNovoPedido">
    <div class="modal">
        <div class="modal-header"><h2 class="modal-title">Novo Pedido de Aprovação</h2><button class="modal-close" onclick="closeModal('modalNovoPedido')">&times;</button></div>
        <form method="post" asp-controller="Home" asp-action="CriarPedido">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <div class="form-row">
                    <div class="form-group"><label class="form-label">Colaborador Solicitante *</label>
                        <select class="form-select" name="idColaborador" required>
                            <option value="">Seleccionar...</option>
                            @foreach (var c in Model.Colaboradores)
                            {
                                <option value="@c.IdColaborador">@c.NomeCompleto</option>
                            }
                        </select>
                    </div>
                    <div class="form-group"><label class="form-label">Tipo de Pedido *</label>
                        <select class="form-select" name="idTipoPedido" required>
                            <option value="">Seleccionar...</option>
                            @foreach (var t in Model.TiposPedido)
                            {
                                <option value="@t.IdTipoPedido">@t.Nome</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-group"><label class="form-label">Descrição *</label><textarea class="form-input" name="descricao" rows="3" required placeholder="Descreva o pedido..."></textarea></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" onclick="closeModal('modalNovoPedido')">Cancelar</button>
                <button type="submit" class="btn btn-primary"><i class="fi fi-sr-check"></i> Submeter Pedido</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Decidir Pedido (workflow de parecer e aprovação) -->
<div class="modal-overlay" id="modalDecisao">
    <div class="modal" style="max-width:480px;">
        <div class="modal-header"><h2 class="modal-title">Parecer e Aprovação</h2><button class="modal-close" onclick="closeModal('modalDecisao')">&times;</button></div>
        <form method="post" asp-controller="Home" asp-action="DecidirPedido">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <p style="margin-bottom:1rem;"><strong id="decNome"></strong> — <span id="decTipo" class="chip"></span></p>
                <div class="form-group"><label class="form-label">Parecer</label><textarea class="form-input" name="parecer" rows="3" placeholder="Parecer sobre o pedido (opcional)..."></textarea></div>
                <div class="form-group"><label class="form-label">Decisão *</label>
                    <select class="form-select" name="decisao" required>
                        <option value="Aprovado">Aprovado</option>
                        <option value="Rejeitado">Rejeitado</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <input type="hidden" name="id" id="decId" />
                <button type="button" class="btn btn-outline" onclick="closeModal('modalDecisao')">Cancelar</button>
                <button type="submit" class="btn btn-primary"><i class="fi fi-sr-check"></i> Registar Decisão</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Novo Tipo de Ausência -->
<div class="modal-overlay" id="modalNovoTipo">
    <div class="modal" style="max-width:440px;">
        <div class="modal-header"><h2 class="modal-title">Novo Tipo de Ausência</h2><button class="modal-close" onclick="closeModal('modalNovoTipo')">&times;</button></div>
        <form method="post" asp-controller="Home" asp-action="CriarTipoAusencia">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <div class="form-group"><label class="form-label">Nome *</label><input class="form-input" name="nome" required></div>
                <div class="form-group"><label class="form-label">Descrição</label><input class="form-input" name="descricao"></div>
                <div class="form-group"><label class="form-label">Dias Máximos</label><input class="form-input" type="number" name="diasMaximos" min="1"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" onclick="closeModal('modalNovoTipo')">Cancelar</button>
                <button type="submit" class="btn btn-primary"><i class="fi fi-sr-check"></i> Criar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
// Tabs
$('#tabsAdmin .tab-item').on('click', function() {
    $('#tabsAdmin .tab-item').removeClass('active');
    $(this).addClass('active');
    var tab = $(this).data('admintab');
    $('#adm-pedidos, #adm-ausencias, #adm-tipos').hide();
    $('#adm-' + tab).show();
});

function abrirEditarAusencia(a) {
    document.getElementById('eaId').value = a.id;
    document.getElementById('eaTipo').value = a.idTipo;
    document.getElementById('eaEstado').value = a.estado;
    document.getElementById('eaInicio').value = a.inicio;
    document.getElementById('eaFim').value = a.fim;
    document.getElementById('eaMotivo').value = a.motivo || '';
    openModal('modalEditarAusencia');
}

function abrirDecisao(p) {
    document.getElementById('decId').value = p.id;
    document.getElementById('decNome').textContent = p.nome;
    document.getElementById('decTipo').textContent = p.tipo;
    openModal('modalDecisao');
}
</script>
}
