@model IEnumerable<SGRH.Models.Colaborador>
@{
    ViewData["Title"] = "Colaboradores";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Colaboradores</h1>
        <p class="page-subtitle">Gestão do processo individual dos funcionários</p>
    </div>
    <div style="display:flex;gap:0.5rem;">
        <button class="btn btn-outline" onclick="gerarFicha()"><i class="fi fi-sr-file-pdf"></i> Gerar Ficha</button>
        <a href="/Home/NovoColaborador" class="btn btn-primary"><i class="fi fi-sr-plus"></i> Novo Colaborador</a>
    </div>
</div>

@if (TempData["Toast"] != null)
{
    <script>
        $(document).ready(function() {
            showToast('@TempData["Toast"]');
        });
    </script>
}

<div class="card">
    <div class="card-header">
        <div class="tabs" id="tabsColab" style="border-bottom:none;margin-bottom:0;">
            <button class="tab-item active" data-tab="todos">Todos</button>
            <button class="tab-item" data-tab="ativos">Ativos</button>
            <button class="tab-item" data-tab="inativos">Inativos</button>
        </div>
        <div class="topbar-search" style="width:auto;">
            <i class="fi fi-sr-search"></i>
            <input type="text" id="pesquisarColab" placeholder="Pesquisar colaborador..." style="width:220px;">
        </div>
    </div>
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Colaborador</th>
                    <th>NUIT</th>
                    <th>Unidade Orgânica</th>
                    <th>Categoria</th>
                    <th>Função</th>
                    <th>Estado</th>
                    <th>Idade</th>
                    <th>Tempo Serviço</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody id="corpoTabela">
                @foreach (var c in Model)
                {
                    var hoje = DateOnly.FromDateTime(DateTime.Today);
                    var idade = hoje.Year - c.DataNascimento.Year;
                    if (c.DataNascimento > hoje.AddYears(-idade)) idade--;

                    var tempoServico = hoje.Year - c.DataIngresso.Year;
                    if (c.DataIngresso > hoje.AddYears(-tempoServico)) tempoServico--;

                    var iniciais = string.Join("", c.NomeCompleto.Split(' ').Take(2).Select(p => p[0].ToString().ToUpper()));

                    <tr data-estado="@c.Estado"
                        data-id="@c.IdColaborador"
                        data-nome="@c.NomeCompleto"
                        data-nuit="@c.Nuit"
                        data-sexo="@c.Sexo"
                        data-estadocivil="@c.EstadoCivil?.Nome"
                        data-nacionalidade="@c.Nacionalidade"
                        data-contacto="@c.ContactoTelefonico"
                        data-email="@c.ContactoEmail"
                        data-unidade="@c.UnidadeOrganica?.Nome"
                        data-categoria="@c.Categoria?.Descricao"
                        data-carreira="@c.Carreira?.Nome"
                        data-funcao="@c.Funcao?.Nome"
                        data-dataingresso="@c.DataIngresso.ToString("yyyy-MM-dd")"
                        data-formaingresso="@c.FormaIngresso?.Nome"
                        data-fotopath="@c.FotoPath"
                        data-iniciais="@iniciais">
                        <td>
                            <div class="table-user">
                                @if (!string.IsNullOrEmpty(c.FotoPath))
                                {
                                    <div class="table-avatar" style="overflow:hidden;"><img src="@c.FotoPath" style="width:100%;height:100%;object-fit:cover;border-radius:50%;"></div>
                                }
                                else
                                {
                                    <div class="table-avatar">@iniciais</div>
                                }
                                <div class="table-user-info"><span class="name">@c.NomeCompleto</span></div>
                            </div>
                        </td>
                        <td>@(c.Nuit ?? "-")</td>
                        <td>@(c.UnidadeOrganica?.Nome ?? "-")</td>
                        <td>@(c.Categoria?.Descricao ?? "-")</td>
                        <td>@(c.Funcao?.Nome ?? "-")</td>
                        <td>
                            @if (c.Estado == "Ativo")
                            {
                                <span class="badge badge-success">Ativo</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">Inativo</span>
                            }
                        </td>
                        <td>@idade anos</td>
                        <td>@tempoServico anos</td>
                        <td>
                            <div style="display:flex;gap:0.25rem;">
                                <button class="btn btn-icon btn-outline" title="Ver Ficha" onclick="verFicha($(this.closest('tr')))"><i class="fi fi-sr-eye"></i></button>
                                <a href="/Home/EditarColaborador?id=@c.IdColaborador" class="btn btn-icon btn-outline" title="Editar"><i class="fi fi-sr-pencil"></i></a>
                                <button class="btn btn-icon btn-outline" title="Registar Progressão" onclick="abrirModalProgressao($(this.closest('tr')))" style="color:var(--primary);"><i class="fi fi-sr-arrow-up"></i></button>
                                <button class="btn btn-icon btn-outline" title="Desativar" onclick="confirmarDelete(@c.IdColaborador, '@c.NomeCompleto.Replace("'", "\\'"))" style="color:var(--danger);"><i class="fi fi-sr-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Ficha Individual -->
<div class="modal-overlay" id="modalFicha">
    <div class="modal" style="max-width:700px;">
        <div class="modal-header">
            <h3 class="modal-title">Ficha Individual do Colaborador</h3>
            <button class="modal-close" onclick="closeModal('modalFicha')"><i class="fi fi-sr-xmark"></i></button>
        </div>
        <div class="modal-body" id="conteudoFicha"></div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('modalFicha')">Fechar</button>
        </div>
    </div>
</div>

<!-- Modal: Registar Progressão -->
<div class="modal-overlay" id="modalProgressao">
    <div class="modal" style="max-width:650px;">
        <div class="modal-header">
            <h3 class="modal-title"><i class="fi fi-sr-arrow-up" style="color:var(--primary);margin-right:0.5rem;"></i> Registar Progressão na Carreira</h3>
            <button class="modal-close" onclick="closeModal('modalProgressao')"><i class="fi fi-sr-xmark"></i></button>
        </div>
        <div class="modal-body">
            <form id="formProgressao">
                <input type="hidden" id="progColabId">
                <div style="background:var(--bg-secondary);padding:0.75rem 1rem;border-radius:6px;margin-bottom:1rem;display:flex;align-items:center;gap:0.75rem;">
                    <div id="progAvatar" class="table-avatar" style="width:40px;height:40px;font-size:0.9rem;"></div>
                    <div>
                        <div id="progNomeColab" style="font-weight:600;font-size:0.95rem;"></div>
                        <div id="progCargoAtual" style="font-size:0.8rem;color:var(--text-secondary);"></div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Tipo de Progressão <span style="color:var(--danger);">*</span></label>
                        <select class="form-select" id="progTipo" required>
                            <option value="Promoção">Promoção de Categoria</option>
                            <option value="Progressão">Progressão por Tempo de Serviço</option>
                            <option value="Nomeação">Nomeação para Nova Função</option>
                            <option value="Reclassificação">Reclassificação Profissional</option>
                            <option value="Mudança de Escalão">Mudança de Escalão / Classe</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Data da Progressão <span style="color:var(--danger);">*</span></label>
                        <input type="date" class="form-input" id="progData" required>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Nova Categoria <span style="color:var(--danger);">*</span></label>
                        <select class="form-select" id="progNovaCategoria" required>
                            <option value="Assessor Principal">Assessor Principal</option>
                            <option value="Primeiro Assessor">Primeiro Assessor</option>
                            <option value="Assessor">Assessor</option>
                            <option value="Técnico Superior Principal">Técnico Superior Principal</option>
                            <option value="Técnico Superior de 1ª Classe">Técnico Superior de 1ª Classe</option>
                            <option value="Técnico Superior de 2ª Classe">Técnico Superior de 2ª Classe</option>
                            <option value="Especialista Principal">Especialista Principal</option>
                            <option value="Especialista de 1ª Classe">Especialista de 1ª Classe</option>
                            <option value="Especialista de 2ª Classe">Especialista de 2ª Classe</option>
                            <option value="Técnico de 1ª Classe">Técnico de 1ª Classe</option>
                            <option value="Técnico de 2ª Classe">Técnico de 2ª Classe</option>
                            <option value="Técnico de 3ª Classe">Técnico de 3ª Classe</option>
                            <option value="Técnico Médio Principal">Técnico Médio Principal</option>
                            <option value="Técnico Médio de 1ª Classe">Técnico Médio de 1ª Classe</option>
                            <option value="Técnico Médio de 2ª Classe">Técnico Médio de 2ª Classe</option>
                            <option value="Técnico Médio de 3ª Classe">Técnico Médio de 3ª Classe</option>
                            <option value="Oficial Administrativo Principal">Oficial Administrativo Principal</option>
                            <option value="1º Oficial Administrativo">1º Oficial Administrativo</option>
                            <option value="2º Oficial Administrativo">2º Oficial Administrativo</option>
                            <option value="3º Oficial Administrativo">3º Oficial Administrativo</option>
                            <option value="Auxiliar Administrativo">Auxiliar Administrativo</option>
                            <option value="Agente de Serviço">Agente de Serviço</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Nova Função</label>
                        <select class="form-select" id="progNovaFuncao">
                            <option value="Director Geral">Director Geral</option>
                            <option value="Director Geral Adjunto">Director Geral Adjunto</option>
                            <option value="Chefe de Departamento">Chefe de Departamento</option>
                            <option value="Chefe de Secção">Chefe de Secção</option>
                            <option value="Estatístico">Estatístico</option>
                            <option value="Técnico de Estatística">Técnico de Estatística</option>
                            <option value="Analista de Dados">Analista de Dados</option>
                            <option value="Cartógrafo">Cartógrafo</option>
                            <option value="Programador">Programador</option>
                            <option value="Técnico de Informática">Técnico de Informática</option>
                            <option value="Administrador de Sistemas">Administrador de Sistemas</option>
                            <option value="Contabilista">Contabilista</option>
                            <option value="Técnico de Administração">Técnico de Administração</option>
                            <option value="Assistente Administrativo">Assistente Administrativo</option>
                            <option value="Secretário de Direcção">Secretário de Direcção</option>
                            <option value="Motorista">Motorista</option>
                            <option value="Agente de Segurança">Agente de Segurança</option>
                            <option value="Auxiliar de Limpeza">Auxiliar de Limpeza</option>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Nº do Despacho / Diploma</label>
                        <input type="text" class="form-input" id="progDespacho" placeholder="Ex: Despacho nº 42/PR/2026">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Nova Remuneração (MZN)</label>
                        <input type="number" class="form-input" id="progNovaRemuneracao" placeholder="Ex: 85000" min="0">
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Fundamentação / Observações</label>
                    <textarea class="form-input" id="progObs" rows="2" placeholder="Motivo ou despacho de suporte da progressão..."></textarea>
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('modalProgressao')">Cancelar</button>
            <button class="btn btn-primary" onclick="salvarProgressao()"><i class="fi fi-sr-check"></i> Registar Progressão</button>
        </div>
    </div>
</div>

<!-- Modal: Confirmar Desativação -->
<div class="modal-overlay" id="modalConfirmarDelete">
    <div class="modal" style="max-width:420px;">
        <div class="modal-header">
            <h3 class="modal-title">Confirmar Desativação</h3>
            <button class="modal-close" onclick="closeModal('modalConfirmarDelete')"><i class="fi fi-sr-xmark"></i></button>
        </div>
        <div class="modal-body">
            <p style="font-size:0.9rem;color:var(--text-secondary);">
                Tem a certeza que deseja desativar o colaborador <strong id="nomeColabDelete"></strong>?
                O colaborador ficará com estado <strong>Inativo</strong> e não aparecerá na listagem principal.
            </p>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('modalConfirmarDelete')">Cancelar</button>
            <form id="formDelete" method="post" action="/Home/EliminarColaborador" style="display:inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteColabId">
                <button type="submit" class="btn btn-danger">Desativar</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
function confirmarDelete(id, nome) {
    $('#deleteColabId').val(id);
    $('#nomeColabDelete').text(nome);
    openModal('modalConfirmarDelete');
}

function verFicha($row) {
    var nome = $row.data('nome') || '';
    var nuit = $row.data('nuit') || '';
    var sexo = $row.data('sexo') === 'M' ? 'Masculino' : 'Feminino';
    var estadoCivil = $row.data('estadocivil') || '-';
    var nacionalidade = $row.data('nacionalidade') || '-';
    var contacto = $row.data('contacto') || '-';
    var email = $row.data('email') || '-';
    var unidade = $row.data('unidade') || '-';
    var categoria = $row.data('categoria') || '-';
    var carreira = $row.data('carreira') || '-';
    var funcao = $row.data('funcao') || '-';
    var dataIngresso = $row.data('dataingresso') || '';
    var formaIngresso = $row.data('formaingresso') || '-';
    var fotoPath = $row.data('fotopath');
    var iniciais = $row.data('iniciais') || '';

    var hoje = new Date();
    var parts = $row.find('td').eq(6).text().trim().split(' ');
    var idade = parts[0] || '-';

    var partsServico = $row.find('td').eq(7).text().trim().split(' ');
    var tempoServico = partsServico[0] || '-';

    var fotoHtml = '';
    if (fotoPath) {
        fotoHtml = '<div class="table-avatar" style="width:64px;height:64px;font-size:1.5rem;overflow:hidden;"><img src="' + fotoPath + '" style="width:100%;height:100%;object-fit:cover;border-radius:50%;"></div>';
    } else {
        fotoHtml = '<div class="table-avatar" style="width:64px;height:64px;font-size:1.5rem;">' + iniciais + '</div>';
    }

    var html = '<div style="display:flex;gap:1.5rem;align-items:flex-start;margin-bottom:1.25rem;">' +
        fotoHtml +
        '<div><h3 style="font-size:1.1rem;font-weight:700;">' + nome + '</h3>' +
        '<p style="font-size:0.85rem;color:var(--text-secondary);">' + funcao + ' — ' + unidade + '</p>' +
        '<span class="badge badge-success">' + (estadoCivil || 'Ativo') + '</span></div></div>' +
        '<div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;font-size:0.85rem;">' +
        '<div><strong>NUIT:</strong> ' + (nuit || '-') + '</div>' +
        '<div><strong>Sexo:</strong> ' + sexo + '</div>' +
        '<div><strong>Estado Civil:</strong> ' + estadoCivil + '</div>' +
        '<div><strong>Nacionalidade:</strong> ' + nacionalidade + '</div>' +
        '<div><strong>Contacto:</strong> ' + contacto + '</div>' +
        '<div><strong>Email:</strong> ' + email + '</div>' +
        '<div><strong>Idade:</strong> ' + idade + ' anos</div>' +
        '<div><strong>Categoria:</strong> ' + categoria + '</div>' +
        '<div><strong>Carreira:</strong> ' + carreira + '</div>' +
        '<div><strong>Unidade:</strong> ' + unidade + '</div>' +
        '<div><strong>Data de Ingresso:</strong> ' + dataIngresso + '</div>' +
        '<div><strong>Tempo de Serviço:</strong> ' + tempoServico + ' anos</div>' +
        '<div><strong>Forma de Ingresso:</strong> ' + formaIngresso + '</div>' +
        '</div>';
    $('#conteudoFicha').html(html);
    openModal('modalFicha');
}

function abrirModalProgressao($row) {
    var id = $row.data('id');
    var nome = $row.data('nome') || '';
    var categoria = $row.data('categoria') || 'Sem categoria';
    var funcao = $row.data('funcao') || 'Sem função';
    var unidade = $row.data('unidade') || '';
    var fotoPath = $row.data('fotopath');
    var iniciais = $row.data('iniciais') || '';

    $('#progColabId').val(id);
    $('#progNomeColab').text(nome);
    $('#progCargoAtual').text(categoria + ' • ' + funcao + ' • ' + unidade);

    if (fotoPath) {
        $('#progAvatar').html('<img src="' + fotoPath + '" style="width:100%;height:100%;object-fit:cover;border-radius:50%;">');
    } else {
        $('#progAvatar').html(iniciais);
    }

    $('#progData').val(new Date().toISOString().split('T')[0]);
    $('#progNovaCategoria').val(categoria);
    $('#progNovaFuncao').val(funcao);
    $('#progDespacho').val('');
    $('#progObs').val('');
    openModal('modalProgressao');
}

function salvarProgressao() {
    var nome = $('#progNomeColab').text();
    var tipo = $('#progTipo').val();
    var data = $('#progData').val();
    var despacho = $('#progDespacho').val();

    if (!data) {
        showToast('Preencha a data da progressão.', 'warning');
        return;
    }

    closeModal('modalProgressao');
    showToast('Progressão de "' + nome + '" registada com sucesso!');
}

function gerarFicha() {
    var $firstRow = $('#corpoTabela tr[data-estado]').first();
    if ($firstRow.length === 0) {
        showToast('Não há colaboradores para gerar ficha.', 'warning');
        return;
    }
    verFicha($firstRow);
}

$(document).ready(function() {
    var flash = '@(TempData["Toast"])';
    if (flash) {
        showToast(flash);
    }

    $('#tabsColab .tab-item').on('click', function() {
        $('#tabsColab .tab-item').removeClass('active');
        $(this).addClass('active');
        var tab = $(this).data('tab');
        var $rows = $('#corpoTabela tr[data-estado]');

        if (tab === 'todos') {
            $rows.show();
        } else if (tab === 'ativos') {
            $rows.hide().filter('[data-estado="Ativo"]').show();
        } else if (tab === 'inativos') {
            $rows.hide().filter('[data-estado="Inativo"]').show();
        }
    });

    $('#pesquisarColab').on('input', function() {
        var termo = $(this).val().toLowerCase();
        $('#corpoTabela tr[data-estado]').each(function() {
            var $row = $(this);
            var nome = ($row.data('nome') || '').toLowerCase();
            var nuit = ($row.data('nuit') || '').toLowerCase();
            var unidade = ($row.data('unidade') || '').toLowerCase();
            var funcao = ($row.data('funcao') || '').toLowerCase();
            var match = nome.indexOf(termo) > -1 || nuit.indexOf(termo) > -1 || unidade.indexOf(termo) > -1 || funcao.indexOf(termo) > -1;
            $row.toggle(match);
        });
    });
});
</script>
}
