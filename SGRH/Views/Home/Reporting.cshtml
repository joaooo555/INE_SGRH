@{
    ViewData["Title"] = "Reporting";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Reporting e Analytics</h1>
        <p class="page-subtitle">Dashboards interativos e indicadores de desempenho</p>
    </div>
    <div style="display:flex;gap:0.5rem;">
        <button class="btn btn-outline" id="btnExportPDF"><i class="fi fi-sr-file-pdf"></i> Exportar PDF</button>
        <button class="btn btn-outline" id="btnExportExcel"><i class="fi fi-sr-file-excel"></i> Exportar Excel</button>
    </div>
</div>

<!-- Filtros -->
<div class="card" style="margin-bottom:1.5rem;">
    <div class="card-body">
        <div class="reporting-filters">
            <div class="form-group" style="margin:0;">
                <label class="form-label">Período</label>
                <input class="form-input" type="text" id="filtroPeriodo" placeholder="Seleccionar período...">
            </div>
            <div class="form-group" style="margin:0;">
                <label class="form-label">Unidade Orgânica</label>
                <select class="form-select" id="filtroUnidadeRep">
                    <option value="">Todas</option>
                    <option>Direcção Geral</option>
                    <option>Direcção de RH</option>
                    <option>Departamento de TI</option>
                    <option>Departamento de Contabilidade</option>
                    <option>Divisão de Administração</option>
                </select>
            </div>
            <div class="form-group" style="margin:0;">
                <label class="form-label">Categoria</label>
                <select class="form-select">
                    <option value="">Todas</option>
                    <option>Quartel General</option>
                    <option>Quadro Superior</option>
                    <option>Quadro Intermediário</option>
                    <option>Quadro Técnico</option>
                </select>
            </div>
            <button class="btn btn-primary" id="btnAplicarFiltros"><i class="fi fi-sr-filter"></i> Aplicar</button>
        </div>
    </div>
</div>

<!-- KPIs -->
<div class="stats-grid" style="margin-bottom:1.5rem;">
    <div class="stat-card"><div class="stat-info"><h3>Total Colaboradores</h3><div class="stat-value">150</div><span class="stat-change positive"><i class="fi fi-sr-arrow-up"></i> +8% vs ano anterior</span></div><div class="stat-icon blue"><i class="fi fi-sr-users"></i></div></div>
    <div class="stat-card"><div class="stat-info"><h3>Taxa de Rotatividade</h3><div class="stat-value">4.2%</div><span class="stat-change positive"><i class="fi fi-sr-arrow-down"></i> -1.3% vs mês anterior</span></div><div class="stat-icon green"><i class="fi fi-sr-chart-mixed"></i></div></div>
    <div class="stat-card"><div class="stat-info"><h3>Taxa de Assiduidade</h3><div class="stat-value" style="color:var(--success);">94.2%</div><span class="stat-change positive"><i class="fi fi-sr-arrow-up"></i> +1.3% vs mês anterior</span></div><div class="stat-icon green"><i class="fi fi-sr-check-circle"></i></div></div>
    <div class="stat-card"><div class="stat-info"><h3>Horas Formação</h3><div class="stat-value">1,240</div><span class="stat-change positive"><i class="fi fi-sr-arrow-up"></i> +180 este trimestre</span></div><div class="stat-icon blue"><i class="fi fi-sr-clock"></i></div></div>
</div>

<!-- Charts Row 1 -->
<div class="grid-2" style="margin-bottom:1.5rem;">
    <div class="card"><div class="card-header"><span class="card-title">Estrutura Etária</span></div><div class="card-body"><canvas id="chartIdadeRep" height="250"></canvas></div></div>
    <div class="card"><div class="card-header"><span class="card-title">Distribuição por Sexo</span></div><div class="card-body"><canvas id="chartSexo" height="250"></canvas></div></div>
</div>

<!-- Charts Row 2 -->
<div class="grid-2" style="margin-bottom:1.5rem;">
    <div class="card"><div class="card-header"><span class="card-title">Admissões vs Desistências</span></div><div class="card-body"><canvas id="chartRotatividadeRep" height="250"></canvas></div></div>
    <div class="card"><div class="card-header"><span class="card-title">Distribuição por Unidade</span></div><div class="card-body"><canvas id="chartUnidadesRep" height="250"></canvas></div></div>
</div>

<!-- Charts Row 3 -->
<div class="grid-2" style="margin-bottom:1.5rem;">
    <div class="card"><div class="card-header"><span class="card-title">Índice de Capacitação</span></div><div class="card-body"><canvas id="chartCapacitacaoRep" height="250"></canvas></div></div>
    <div class="card"><div class="card-header"><span class="card-title">Distribuição por Categoria</span></div><div class="card-body"><canvas id="chartCategoria" height="250"></canvas></div></div>
</div>

<!-- Tabela Resumo -->
<div class="card" style="margin-bottom:1.5rem;">
    <div class="card-header"><span class="card-title"><i class="fi fi-sr-table" style="color:var(--info);margin-right:0.5rem;"></i> Resumo por Unidade Orgânica</span></div>
    <div class="card-body" style="padding:0;">
        <div class="table-container">
            <table>
                <thead><tr><th>Unidade Orgânica</th><th>Colaboradores</th><th>Idade Média</th><th>Assiduidade</th><th>Horas Formação</th><th>Rotatividade</th><th>Satisfação</th></tr></thead>
                <tbody>
                    <tr><td><strong>Direcção Geral</strong></td><td>8</td><td>48 anos</td><td><span class="badge badge-success">97.5%</span></td><td>120h</td><td>2.1%</td><td><span class="badge badge-success">92%</span></td></tr>
                    <tr><td><strong>Direcção de RH</strong></td><td>22</td><td>35 anos</td><td><span class="badge badge-success">95.3%</span></td><td>280h</td><td>3.8%</td><td><span class="badge badge-success">89%</span></td></tr>
                    <tr><td><strong>Departamento de TI</strong></td><td>18</td><td>31 anos</td><td><span class="badge badge-success">96.1%</span></td><td>340h</td><td>5.2%</td><td><span class="badge badge-success">88%</span></td></tr>
                    <tr><td><strong>Depart. Contabilidade</strong></td><td>15</td><td>38 anos</td><td><span class="badge badge-success">94.8%</span></td><td>180h</td><td>2.9%</td><td><span class="badge badge-success">85%</span></td></tr>
                    <tr><td><strong>Divisão de Formação</strong></td><td>12</td><td>33 anos</td><td><span class="badge badge-success">93.5%</span></td><td>220h</td><td>4.5%</td><td><span class="badge badge-success">91%</span></td></tr>
                    <tr><td><strong>Secções</strong></td><td>31</td><td>29 anos</td><td><span class="badge badge-warning">91.2%</span></td><td>100h</td><td>6.3%</td><td><span class="badge badge-warning">82%</span></td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- IA Analysis -->
<div class="card" style="border-left:4px solid #8b5cf6;">
    <div class="card-header" style="background:rgba(139,92,246,0.03);">
        <span class="card-title" style="color:#7c3aed;"><i class="fi fi-sr-brain-circuit" style="margin-right:0.5rem;"></i> Análise com IA (llama)</span>
        <button class="btn btn-sm" style="background:rgba(139,92,246,0.1);color:#7c3aed;" id="btnAtualizarIA"><i class="fi fi-sr-refresh"></i> Atualizar</button>
    </div>
    <div class="card-body" id="analiseIA">
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem;">
            <div style="padding:0.75rem;background:rgba(34,197,94,0.05);border-radius:0.5rem;"><div style="font-size:0.75rem;color:var(--text-muted);margin-bottom:0.25rem;">Ponto Forte</div><p style="font-size:0.85rem;font-weight:500;">Taxa de assiduidade acima da média nacional (94.2% vs 90.1%). Destaque para Direcção Geral com 97.5%.</p></div>
            <div style="padding:0.75rem;background:rgba(245,158,11,0.05);border-radius:0.5rem;"><div style="font-size:0.75rem;color:var(--text-muted);margin-bottom:0.25rem;">Área de Melhoria</div><p style="font-size:0.85rem;font-weight:500;">Rotatividade nas Secções (6.3%) acima do desejável. Recomenda-se programa de retenção.</p></div>
            <div style="padding:0.75rem;background:rgba(59,130,246,0.05);border-radius:0.5rem;"><div style="font-size:0.75rem;color:var(--text-muted);margin-bottom:0.25rem;">Previsão</div><p style="font-size:0.85rem;font-weight:500;">Com base nas tendências, projecta-se crescimento de 5% no efectivo até final de 2026.</p></div>
        </div>
    </div>
</div>

@section Scripts {
<script>
$(document).ready(function() {
    // Flatpickr
    if (typeof flatpickr !== 'undefined') {
        flatpickr('#filtroPeriodo', { mode: 'range', locale: 'pt', dateFormat: 'Y-m-d' });
    }

    // Charts
    var ctxIdade = document.getElementById('chartIdadeRep');
    if (ctxIdade) { new Chart(ctxIdade, { type: 'doughnut', data: { labels: ['20-30 anos','31-40 anos','41-50 anos','51-60 anos','60+ anos'], datasets: [{ data: [35,52,38,18,7], backgroundColor: ['#3b82f6','#22c55e','#f59e0b','#ef4444','#8b5cf6'], borderWidth: 0, spacing: 2 }] }, options: { responsive: true, maintainAspectRatio: false, cutout: '55%', plugins: { legend: { position: 'bottom', labels: { padding: 12, usePointStyle: true, font: { size: 11 } } } } } }); }

    var ctxSexo = document.getElementById('chartSexo');
    if (ctxSexo) { new Chart(ctxSexo, { type: 'pie', data: { labels: ['Masculino','Feminino'], datasets: [{ data: [78,72], backgroundColor: ['#3b82f6','#ec4899'], borderWidth: 0, spacing: 2 }] }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { padding: 16, usePointStyle: true, font: { size: 11 } } } } } }); }

    var ctxRot = document.getElementById('chartRotatividadeRep');
    if (ctxRot) { new Chart(ctxRot, { type: 'bar', data: { labels: ['Jan','Fev','Mar','Abr','Mai','Jun'], datasets: [{ label: 'Admissões', data: [4,2,5,3,6,2], backgroundColor: '#22c55e', borderRadius: 4, barThickness: 20 }, { label: 'Desistências', data: [1,2,1,3,2,1], backgroundColor: '#ef4444', borderRadius: 4, barThickness: 20 }] }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { padding: 12, usePointStyle: true, font: { size: 11 } } } }, scales: { y: { beginAtZero: true, grid: { color: '#f1f5f9' } }, x: { grid: { display: false } } } } }); }

    var ctxUnid = document.getElementById('chartUnidadesRep');
    if (ctxUnid) { new Chart(ctxUnid, { type: 'bar', data: { labels: ['Dir. Geral','Dir. RH','TI','Contab.','Admin.','Formação','Clima','Social','Secções'], datasets: [{ label: 'Colaboradores', data: [8,22,18,15,20,12,10,14,31], backgroundColor: ['#1e3a5f','#3b82f6','#60a5fa','#93c5fd','#22c55e','#86efac','#f59e0b','#fbbf24','#a78bfa'], borderRadius: 6, barThickness: 28 }] }, options: { responsive: true, maintainAspectRatio: false, indexAxis: 'y', plugins: { legend: { display: false } }, scales: { x: { beginAtZero: true, grid: { color: '#f1f5f9' } }, y: { grid: { display: false } } } } }); }

    var ctxCap = document.getElementById('chartCapacitacaoRep');
    if (ctxCap) { new Chart(ctxCap, { type: 'radar', data: { labels: ['Gestão','Tecnologia','Ética','Liderança','Segurança','Idiomas'], datasets: [{ label: 'Realizado', data: [85,120,40,60,50,35], backgroundColor: 'rgba(59,130,246,0.2)', borderColor: '#3b82f6', pointBackgroundColor: '#3b82f6' }, { label: 'Planeado', data: [100,100,60,80,70,50], backgroundColor: 'rgba(148,163,184,0.1)', borderColor: '#94a3b8', borderDash: [5,5], pointBackgroundColor: '#94a3b8' }] }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { padding: 12, usePointStyle: true, font: { size: 11 } } } }, scales: { r: { beginAtZero: true, grid: { color: '#e2e8f0' }, ticks: { display: false } } } } }); }

    var ctxCat = document.getElementById('chartCategoria');
    if (ctxCat) { new Chart(ctxCat, { type: 'bar', data: { labels: ['Quartel General','Quadro Superior','Quadro Intermediário','Quadro Técnico','Quadro de Apoio'], datasets: [{ label: 'Colaboradores', data: [12,28,35,52,23], backgroundColor: ['#1e3a5f','#3b82f6','#22c55e','#f59e0b','#94a3b8'], borderRadius: 6, barThickness: 32 }] }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, grid: { color: '#f1f5f9' } }, x: { grid: { display: false } } } } }); }

    // Buttons
    $('#btnExportPDF').on('click', function() { showToast('PDF gerado com sucesso!', 'success'); });
    $('#btnExportExcel').on('click', function() { showToast('Excel gerado com sucesso!', 'success'); });
    $('#btnAplicarFiltros').on('click', function() { showToast('Filtros aplicados!', 'success'); });
    $('#btnAtualizarIA').on('click', function() {
        $('#analiseIA').css('opacity', '0.5');
        setTimeout(function() { $('#analiseIA').css('opacity', '1'); showToast('Análise de IA actualizada com sucesso!', 'success'); }, 1500);
    });
});
</script>
}
